{
  "name": "n8n-nodes-transcribe-audio",
  "version": "0.2.3",
  "description": "Perform local speech-to-text. Transcribe audio files locally in self-hosted n8n with Whisper. No transcription API key required.",
  "keywords": [
    "n8n-community-node-package",
    "transcribe audio",
    "transcribe",
    "audio",
    "transcription",
    "subtitles",
    "captions",
    "speech-to-text",
    "meeting transcription",
    "voice notes",
    "podcast transcription",
    "interview transcription",
    "whisper",
    "wav",
    "mp3"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/dioveath/n8n-nodes-transcribe-audio#readme",
  "author": {
    "name": "raisaroj",
    "email": "raisaroj360@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dioveath/n8n-nodes-transcribe-audio.git"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier nodes tests --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "pnpm run test:community",
    "test:community": "sh tests/alpine/run-community-test.sh",
    "test:community:smoke": "RUN_TRANSCRIPTION_TEST=false sh tests/alpine/run-community-test.sh",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "deploy:prepare": "pnpm run build && sh scripts/prepare-dev-package.sh",
    "deploy": "pnpm run deploy:prepare && docker compose up"
  },
  "files": [
    "dist/nodes/AudioTranscribe"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "nodes": [
      "dist/nodes/AudioTranscribe/AudioTranscribe.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.44.5",
    "@types/node": "^24.13.3",
    "eslint": "9.39.5",
    "n8n-workflow": "2.16.0",
    "prettier": "3.9.6",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "@audio/decode-mp3": "1.3.1",
    "onnxruntime-node": "npm:onnxruntime-web@1.24.3",
    "transformers-wasm": "npm:@huggingface/transformers@4.2.0",
    "wavefile": "^11.0.0"
  }
}
